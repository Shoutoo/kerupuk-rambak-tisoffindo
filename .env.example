# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Telegram customer bot (configure server-side values in Vercel project settings).
# Never prefix secrets with VITE_: those are exposed to every website visitor.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
PUBLIC_SITE_URL=""
# Public username only; enables the Telegram button in the website build.
VITE_TELEGRAM_BOT_USERNAME=""

# Frontend public Supabase config (anon/publishable key only — NEVER service role).
VITE_SUPABASE_URL="https://kiwdioyxftsixxcuryhn.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Public n8n Chat Trigger webhook URL for the website chat widget.
VITE_N8N_CHAT_WEBHOOK_URL="https://soffinhalim.app.n8n.cloud/webhook/068f945a-d9c7-4fbf-9fca-f0b279d932f1/chat"
